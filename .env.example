NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public base URL used in auth emails (password recovery). Production:
# SITE_URL=https://hook-marketing.vercel.app   (omit locally -> http://localhost:3000)
SITE_URL=

# --- Integrations (server-only: never prefix these with NEXT_PUBLIC_) ---

# Google Drive OAuth — Google Cloud Console > APIs & Services > Credentials (OAuth client, Web).
# Enable the Google Drive API. The redirect URI must match the console entry exactly.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/integrations/google/callback

# Meta OAuth — Meta for Developers > your app > App settings. Add the redirect URI under
# Facebook Login > Valid OAuth Redirect URIs.
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:3000/api/integrations/meta/callback

# Meta ad publishing safety switch. Keep "false" until the Meta app has Marketing API
# access (ads_management, pages_manage_ads). When "true", the OAuth connect flow also
# requests those scopes (reconnect Meta after changing it) and Super Admins can publish
# approved campaigns — always created PAUSED.
META_PUBLISHING_ENABLED=false

# Cost guard: max paid AI calls (Claude + Fal.ai) per client per hour. Default 60.
AI_HOURLY_CALL_LIMIT=60

# Claude and Fal.ai API keys are managed by Super Admins in
# Settings > Integrations and stored encrypted in Supabase Vault — no env vars needed.
